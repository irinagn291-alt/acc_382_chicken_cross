          }
        }
      }
    },
    "privacyText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your routes, coins, hens and records stay on this device. Widgets read the same local save. No ads, tracking, purchases or developer servers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routen, Münzen, Hühner und Rekorde bleiben auf diesem Gerät. Widgets lesen denselben lokalen Spielstand. Keine Werbung, kein Tracking, keine Käufe und keine eigenen Server."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotas, moedas, galinhas e recordes ficam neste dispositivo. Os widgets leem os mesmos dados locais. Sem anúncios, rastreamento, compras ou servidores próprios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos parcours, pièces, poules et records restent sur cet appareil. Les widgets lisent cette sauvegarde locale. Sans publicité, suivi, achats ni serveurs propres."
          }
        }
      }
    },
    "gcPrivacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare scores on this device and exchange scorecards directly. Disconnect below to stop future score sharing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche Ergebnisse auf diesem Gerät und tausche Ergebniskarten direkt aus. Trenne die Verbindung, um keine weiteren Ergebnisse zu teilen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare resultados no dispositivo e troque cartões de pontuação diretamente. Desconecte abaixo para parar de compartilhar novas pontuações."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez les résultats sur cet appareil et échangez vos fiches de score. Déconnectez-vous ci-dessous pour arrêter l’envoi de nouveaux scores."
          }
        }
      }
    },
