    "remindersHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local reminder at 09:00 for the new place and at 18:00 for daily tasks. No server is involved. You can turn these off anytime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Erinnerungen um 09:00 zum neuen Ort und um 18:00 zu den Tagesaufgaben. Ohne Server. Jederzeit ausschaltbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes locais às 09:00 para o novo lugar e às 18:00 para as tarefas diárias. Sem servidor. Desative quando quiser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel local à 09:00 pour le nouveau lieu et à 18:00 pour les défis du jour. Aucun serveur. Désactivez-les à tout moment."
          }
        }
      }
    },
