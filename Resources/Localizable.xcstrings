    "freeForever": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free to play. No ads. Made for little adventures."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
