    "rulesText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the field or the up arrow to hop forward. Swipe or use arrows to move sideways or back. Trees block your path. You can move back up to five rows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe aufs Feld oder den Pfeil nach oben, um vorwärts zu hüpfen. Wische oder nutze Pfeile, um seitlich oder zurück zu gehen. Bäume versperren den Weg. Du kannst bis zu fünf Reihen zurück."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no campo ou na seta para cima para avançar. Deslize ou use as setas para ir aos lados ou para trás. Árvores bloqueiam o caminho. É possível recuar até cinco fileiras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le terrain ou la flèche du haut pour avancer. Glissez ou utilisez les flèches pour aller sur les côtés ou reculer. Les arbres bloquent le passage. Vous pouvez reculer de cinq rangées."
          }
        }
      }
    },
    "riverHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross water on moving logs. Stay aboard and hop to the next log before it drifts away."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überquere Flüsse auf treibenden Stämmen. Bleibe darauf und hüpfe weiter, bevor du abtreibst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atravesse a água nos troncos em movimento. Fique neles e pule para o próximo antes de sair do campo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traversez l’eau sur les troncs flottants. Restez dessus et sautez au suivant avant qu’il ne s’éloigne."
          }
        }
      }
    },
    "railHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid cars. A red railway light means a train is approaching. Wait on the grass until the tracks are clear."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiche Autos aus. Rotes Licht an den Gleisen kündigt einen Zug an. Warte im Gras, bis die Gleise frei sind."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desvie dos carros. A luz vermelha indica que um trem se aproxima. Espere na grama até os trilhos ficarem livres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez les voitures. Le feu rouge annonce un train. Attendez sur l’herbe que la voie soit libre."
          }
        }
      }
    },
