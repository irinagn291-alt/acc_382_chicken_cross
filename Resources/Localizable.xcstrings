    "flockHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find coins on the path. Collect a new look. Every hen hops the same."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde Münzen auf dem Weg und sammle neue Farben. Jedes Huhn hüpft gleich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre moedas pelo caminho e colecione novos visuais. Todas pulam do mesmo jeito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramassez des pièces et collectionnez les couleurs. Toutes les poules avancent de la même façon."
